ENVIRONMENT=development

# Set to false to require real MQTT/InfluxDB (hardware or docker-compose stack)
MOCK_MODE=true

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=farm

INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=dev-token
INFLUX_ORG=smart-agriculture
INFLUX_BUCKET=sensors

SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123

YOLO_MODEL_PATH=ai/models/plant_disease.pt
CAMERA_INDEX=0
